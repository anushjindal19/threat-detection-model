# ============================================
# Python
# ============================================
__pycache__/
*.py[cod]
*.pyc
*.egg-info/

# ============================================
# Virtual environment
# ============================================
.venv/
venv/
env/

# ============================================
# Jupyter / Colab
# ============================================
.ipynb_checkpoints/

# ============================================
# Dataset files — NEVER commit raw data to GitHub.
# Only data/README.md (which explains where to get the
# data) should be tracked from this folder.
# ============================================
data/*.csv
data/*.zip
data/*.parquet
data/raw/
data/processed/
!data/README.md

# ============================================
# Trained models — these can be large and can always
# be regenerated by re-running the notebooks, so they
# are not tracked. models/.gitkeep keeps the empty
# folder visible in GitHub.
# ============================================
models/*.pkl
models/*.joblib
!models/.gitkeep

# ============================================
# OS junk files
# ============================================
.DS_Store
Thumbs.db
desktop.ini

# ============================================
# Secrets / environment variables (just in case)
# ============================================
.env
